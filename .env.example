# AEGIS Frontend Environment Configuration

# Production / Remote Backend URL (optional)
# Example: https://aegis-backend.onrender.com
# If left empty, API calls will use relative paths ('/api/v1/...') matching the Vite proxy (in dev) or vercel.json rewrite (in prod).
VITE_API_URL=

# Local Vite Dev Proxy target (optional, defaults to http://127.0.0.1:8000)
VITE_BACKEND_TARGET=http://127.0.0.1:8000
