# Database Configuration
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/aegis_db
SQL_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=email_analysis_jobs

# Authentication & Security
JWT_SECRET=aegis-dfir-super-secure-jwt-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ingest Constraints
MAX_EMAIL_SIZE_MB=10

# Evidence Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=storage

# ML Model Parameters
ML_MODEL_PATH=backend/ml/models/aegis_email_classifier.joblib
ML_MODEL_NAME=aegis-email-classifier
ML_MODEL_VERSION=0.1.0

# Forensic Engine & Schema Versions
ANALYSIS_ENGINE_VERSION=1.0.0
FEATURE_SCHEMA_VERSION=1.0

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

# Neo4j Graph Database Configuration (Task 02)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpassword
NEO4J_DATABASE=neo4j

# Graph Store Mode ('neo4j' for production, 'memory' for unit testing)
GRAPH_STORE_TYPE=neo4j
REDIS_INVESTIGATION_QUEUE_NAME=investigation_jobs

# Risk Thresholds
RISK_LOW_MAX=19
RISK_MODERATE_MAX=39
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79
